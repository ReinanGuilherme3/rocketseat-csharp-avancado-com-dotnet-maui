<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PlanShare.App.Views.Pages.OnBoarding.OnBoardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <VerticalStackLayout>

        <Image Source="hero_image.png" />

        <Label
            FontSize="18"
            FontFamily="RalewayBlack"
            HorizontalOptions="Center"
            Text="Tarefas pequenas, grandes resultados." />

        <Label FontSize="18" HorizontalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Não tem uma conta?" FontFamily="WorkSansRefular" />
                    <Span Text=" " />
                    <Span Text="Crie a sua conta!" FontFamily="WorkSansBlack" TextColor="#0065f2" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
    </VerticalStackLayout>
</ContentPage>